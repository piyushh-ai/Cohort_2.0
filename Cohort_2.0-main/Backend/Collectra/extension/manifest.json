{
  "manifest_version": 3,
  "name": "Collectra",
  "version": "1.0.1",
  "description": "Save any webpage to your Collectra vault in one click.",

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "https://your-production-api.com/*",
    "https://your-production-frontend.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Save to Collectra"
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}